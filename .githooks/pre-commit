#!/bin/sh
# Fast local gate (< 1 s): every note is well-formed and INDEX.md is up to date — the same
# check CI runs, so a stale index never reaches GitHub. Enable once per clone:
#     git config core.hooksPath .githooks
PY=python
command -v "$PY" >/dev/null 2>&1 || PY=python3
if ! "$PY" tools/build_index.py --check; then
    echo "pre-commit: fix the errors above or run 'python tools/build_index.py', then commit again." >&2
    exit 1
fi
